{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qedir-pdf",
  "main": "worker/inspektor.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/inspektor", "/inspektor/*"]
  }
}
